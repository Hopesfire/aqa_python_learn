[
  {
    "name": "Flaky tests",
    "matchedStatuses": ["failed", "broken"],
    "flaky": true
  },
  {
    "name": "Product defects",
    "matchedStatuses": ["failed"],
    "traceRegex": ".*AssertionError.*"
  },
  {
    "name": "Test defects",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*TimeoutError.*|.*TimeoutException.*"
  }
]
